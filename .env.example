# Required for live AI analysis. Never place these values in browser code.
OPENAI_API_KEY=sk-your-openai-key-here
# Optional. Enables public web search snippets when a user provides only a LinkedIn URL.
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
# Optional
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
